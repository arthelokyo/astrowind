---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Content from '~/components/widgets/Content.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';

import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';

const appStoreImg = '~/assets/images/app-store.png';
const appStoreDownloadLink = '#';

const googlePlayImg = '~/assets/images/google-play.png';
const googlePlayDownloadLink = '#';

const metadata = {
  title: 'Pronto App — Gestiona tu negocio desde el celular',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="header">
    <Header
      position="left"
      links={[
        { text: 'Características', href: '#features' },
        { text: 'Cómo funciona', href: '#how' },
        { text: 'FAQ', href: '#faq' },
      ]}
      actions={[
        {
          text: 'Descargar',
          href: '#download',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="App para tu negocio"
    image={{
      src: 'https://images.unsplash.com/photo-1535303311164-664fc9ec6532?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Pronto App Hero',
    }}
  >
    <Fragment slot="title">
      <span class="text-accent dark:text-white">Pronto App</span>: <br /> gestiona tu negocio <span
        class="hidden xl:inline">desde el celular</span
      >
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        Recibe pedidos por WhatsApp, actualiza tu catálogo al instante y haz seguimiento en tiempo real.
      </span>
      Descarga la app y empieza a vender más hoy.
    </Fragment>

    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={appStoreDownloadLink}>
        <Image src={appStoreImg} alt="App Store Image" width={200} format="webp" />
      </Button>

      <Button variant="link" href={googlePlayDownloadLink}>
        <Image src={googlePlayImg} alt="Google Play Image" width={200} format="webp" />
      </Button>
    </div>
  </Hero2>

  <!-- Features3 Widget ************** -->

  <Features3
    id="features"
    title="¿Cómo funciona Pronto App?"
    subtitle="En menos de 5 minutos puedes tener tu negocio digitalizado. Tus clientes piden desde el celular y tú gestionas todo desde la app."
    tagline="Guía paso a paso"
    columns={2}
    items={[
      {
        title: 'Descarga la app',
        description: `Descarga Pronto App desde la tienda de tu dispositivo. Crea tu cuenta en segundos y empieza a configurar tu negocio.`,
        icon: 'tabler:square-number-1',
      },
      {
        title: 'Crea tu catálogo con IA',
        description:
          'Toma una foto a tu menú impreso y la IA de Pronto genera automáticamente el catálogo con precios y descripciones. Listo en 5 minutos.',
        icon: 'tabler:square-number-2',
      },
      {
        title: 'Comparte el link con tus clientes',
        description:
          'Reciben un enlace por WhatsApp y pueden ver tu catálogo completo. Hacen su pedido al instante, sin descargar nada.',
        icon: 'tabler:square-number-3',
      },
      {
        title: 'Gestiona pedidos en tiempo real',
        description: `Los pedidos llegan a la app con validación SMS. Aceptas, preparas y el cliente recibe tracking con mapa de seguimiento.`,
        icon: 'tabler:square-number-4',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1521517407911-565264e7d82d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2069&q=80',
      alt: 'App Pronto',
    }}
  />
  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Catálogo con IA',
        description:
          'Sube una foto de tu menú impreso y Pronto genera automáticamente el catálogo completo con precios y descripciones. En 5 minutos tienes todo listo.',
        icon: 'tabler:wand',
      },
      {
        title: 'Pedidos por WhatsApp',
        description:
          'Cada pedido llega directo a tu app con confirmación SMS. Recibe notificaciones al instante y nunca pierdas una venta.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Tracking en tiempo real',
        description:
          'Tus clientes reciben una URL para seguir su pedido paso a paso. Con mapa incluido para entregas a domicilio.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'App de repartidores',
        description:
          'Tu repartidor ve la ruta en el mapa con la mejor ruta de entrega. El cliente también ve la ubicación en tiempo real.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1576153192621-7a3be10b356e?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1674&q=80',
      alt: 'Funcionalidades Pronto',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Funcionalidades principales</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Sin comisiones por pedido',
        description: 'Paga solo una tarifa fija mensual. Sin comisiones ocultas. Todas las ganancias son para ti.',
        icon: 'tabler:receipt',
      },
      {
        title: 'Validación SMS anti-fraude',
        description: 'Cada pedido se confirma con un código SMS único. Evita pedidos falsos y clientes fantasma.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Sin descargas para clientes',
        description: 'Tus clientes piden desde el navegador. Solo compartes un link por WhatsApp y listo.',
        icon: 'tabler:link',
      },
      {
        title: 'Estadísticas de ventas',
        description: `Conoce tus productos más vendidos, horarios pico y el crecimiento de tu negocio. Datos para hacer crecer tu negocio.`,
        icon: 'tabler:chart-bar',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1453738773917-9c3eff1db985?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Ventajas Pronto',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Más ventajas</h3>
    </Fragment>
  </Content>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Pronto en números"
    stats={[
      { title: 'Pedidos gestionados', amount: '12.5K' },
      { title: 'Negocios activos', amount: '500+' },
      { title: 'Productos catalogados', amount: '15K+' },
    ]}
  />

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo que dicen nuestros usuarios"
    testimonials={[
      {
        testimonial: `Pronto me cambió la forma de vender. Mis clientes piden por WhatsApp y yo gestiono todo desde la app. El tracking en tiempo real es un game changer para mi negocio de comida.`,
        name: 'María García',
        job: 'Dueña de restaurante',
        image: {
          src: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'María García',
        },
      },
      {
        testimonial: `Antes perdía pedidos porque no los anotaba bien. Con Pronto todo llega organizado a la app con confirmación SMS. Ahora sí puedo dormir tranquila sabiendo que no se me escapa ninguna venta.`,
        name: 'Carmen López',
        job: 'Pastelera',
        image: {
          src: 'https://images.unsplash.com/flagged/photo-1570612861542-284f4c12e75f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Carmen López',
        },
      },
      {
        testimonial:
          'La IA de Pronto es alucinante. Tomé una foto de mi menú escrito a mano y en 5 minutos tenía el catálogo digital completo. Mis clientes quedan fascinados cuando les envío el link.',
        name: 'Roberto Mendoza',
        job: 'Emprendedor',
        image: {
          src: 'https://images.unsplash.com/photo-1512361436605-a484bdb34b5f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
          alt: 'Roberto Mendoza',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Ver más testimonios',
      href: '#',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    id="faq"
    title="Preguntas frecuentes"
    items={[
      {
        title: '¿Cómo funciona Pronto App?',
        description:
          'Descargas la app, creas tu catálogo con IA tomando una foto a tu menú, compartes el link con tus clientes y empiezas a recibir pedidos por WhatsApp con confirmación SMS y tracking en tiempo real.',
      },
      {
        title: '¿Mis clientes necesitan descargar la app?',
        description:
          'No. Tus clientes solo abren un link desde WhatsApp. Todo funciona en el navegador. Sin descargas, sin registros.',
      },
      {
        title: '¿Está disponible para iOS y Android?',
        description: `Sí, Pronto App está disponible tanto para iOS como para Android. Descárgala desde la App Store o Google Play.`,
      },
      {
        title: '¿Qué la hace diferente a otras apps?',
        description:
          'Pronto usa IA para crear tu catálogo desde una foto, tiene validación SMS anti-fraude, tracking en tiempo real con mapa, y app de repartidores incluida. Todo en una sola plataforma.',
      },
      {
        title: '¿Hay costos?',
        description:
          'Pronto tiene una tarifa fija mensual. Sin comisiones por pedido. Puedes empezar con una prueba gratuita y cancelar cuando quieras.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    id="download"
    title="Descarga Pronto App"
    subtitle="Empieza a recibir pedidos por WhatsApp desde hoy. Crea tu catálogo digital en 5 minutos con IA."
  >
    <div slot="actions" class="flex max-w-sm gap-4">
      <Button variant="link" href={appStoreDownloadLink}>
        <Image src={appStoreImg} alt="App Store Image" width={200} format="webp" />
      </Button>

      <Button variant="link" href={googlePlayDownloadLink}>
        <Image src={googlePlayImg} alt="Google Play Image" width={200} format="webp" />
      </Button>
    </div>
  </CallToAction>
</Layout>
