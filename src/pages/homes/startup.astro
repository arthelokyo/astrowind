---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

import { YouTube } from 'astro-embed';

const metadata = {
  title: 'Página de inicio para startups — Pronto',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Para startups"
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Explorar plantillas',
        href: '#',
        icon: 'tabler:download',
      },
      { text: 'Saber más', href: '#features' },
    ]}
  >
    <Fragment slot="title">
      Fortalece la presencia online de tu <span class="text-accent dark:text-white">startup</span>
      con Pronto
    </Fragment>

    <Fragment slot="subtitle">
      Destaca con plantillas profesionales diseñadas para startups. Crea una imagen de marca sólida y aumenta tu alcance desde el primer día.
    </Fragment>

    <Fragment slot="image">
      <YouTube id="gxBkghlglTg" title="Astro just Launched.... Could it be the ultimate web framework?" />
      <style is:inline>
        lite-youtube {
          margin: 0 auto;
          max-width: 100%;
        }
      </style>
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Sobre nosotros"
    subtitle="Creemos en la magia de convertir sueños en realidades impresionantes. Fundada por desarrolladores apasionados con una visión compartida, creamos plantillas que simplifican el proceso de crear páginas web. Nuestras plantillas combinan la innovación de Astro con la versatilidad de Tailwind CSS."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Stats Widget ****************** -->

  <Stats
    title="El impacto de Pronto en cifras"
    subtitle="Las cifras a continuación reflejan la confianza que nuestros usuarios han depositado en nosotros y los resultados extraordinarios que les hemos ayudado a lograr."
    stats={[
      { title: 'Descargas', amount: '182K' },
      { title: 'Sitios web creados', amount: '87' },
      { title: 'Calificación de usuarios', amount: '4.8' },
      { title: 'Clientes satisfechos', amount: '116K' },
    ]}
  />

  <!-- Brands Widget ****************** -->

  <Brands
    title="Alianzas y colaboraciones"
    subtitle="En Pronto creemos en el poder de la colaboración para impulsar la innovación y crear experiencias excepcionales."
    icons={[]}
    images={[
      {
        src: 'https://cdn.pixabay.com/photo/2015/05/26/09/37/paypal-784404_1280.png',
        alt: 'Paypal',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2021/12/06/13/48/visa-6850402_1280.png',
        alt: 'Visa',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/10/01/10/29/ebay-189064_1280.png',
        alt: 'Ebay',
      },

      {
        src: 'https://cdn.pixabay.com/photo/2015/04/13/17/45/icon-720944_1280.png',
        alt: 'Youtube',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/02/12/09/07/microsoft-80658_1280.png',
        alt: 'Microsoft',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2015/04/23/17/41/node-js-736399_1280.png',
        alt: 'Node JS',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2015/10/31/12/54/google-1015751_1280.png',
        alt: 'Google',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2021/12/06/13/45/meta-6850393_1280.png',
        alt: 'Meta',
      },
      {
        src: 'https://cdn.pixabay.com/photo/2013/01/29/22/53/yahoo-76684_1280.png',
        alt: 'Yahoo',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="¿Qué servicios ofrecemos?"
    subtitle="Ofrecemos una amplia gama de plantillas web que se adaptan a diversas industrias y propósitos como negocios, portafolios, comercio electrónico, blogs, etc."
    items={[
      {
        title: 'Instrucciones de instalación',
        description:
          'Ofrecemos instrucciones claras sobre cómo descargar las plantillas compradas e instalarlas en varias plataformas web o sistemas de gestión de contenido.',
        icon: 'flat-color-icons:document',
      },
      {
        title: 'Demostraciones y vistas previas',
        description:
          'Ofrecemos demostraciones interactivas y vistas previas que permiten a los clientes ver cómo se verá y funcionará la plantilla elegida antes de realizar la compra.',
        icon: 'flat-color-icons:template',
      },
      {
        title: 'Soporte técnico',
        description:
          'Proporcionamos soporte al cliente para cualquier problema técnico relacionado con las plantillas o su implementación.',
        icon: 'flat-color-icons:voice-presentation',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Características principales de nuestras plantillas"
    subtitle="Cuentan con varias características clave para satisfacer eficazmente las necesidades de startups y emprendedores."
    columns={3}
    items={[
      {
        title: 'Diseño moderno y profesional',
        description:
          'Tienen un diseño contemporáneo que refleja las tendencias actuales y da una impresión profesional.',
        icon: 'tabler:artboard',
      },
      {
        title: 'Responsivo y compatible con móviles',
        description: 'Se adaptan perfectamente a diferentes tamaños de pantalla y dispositivos para asegurar una experiencia consistente.',
        icon: 'tabler:picture-in-picture',
      },
      {
        title: 'Personalizables',
        description:
          'Fácilmente personalizables, permitiendo a los usuarios adaptar el diseño, colores, tipografía y contenido para coincidir con su identidad de marca.',
        icon: 'tabler:adjustments-horizontal',
      },
      {
        title: 'Carga rápida',
        description: 'Optimizadas para velocidad para asegurar una experiencia de usuario fluida y buenos rankings en motores de búsqueda.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Optimización para motores de búsqueda (SEO)',
        description:
          'Incorporamos las mejores prácticas de SEO en la estructura y código de las plantillas para mejorar la visibilidad en los resultados de búsqueda.',
        icon: 'tabler:arrows-right-left',
      },
      {
        title: 'Compatibilidad',
        description: 'Las plantillas funcionan perfectamente en diversos sistemas de gestión de contenido y creadores de sitios web.',
        icon: 'tabler:plug-connected',
      },
    ]}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas frecuentes"
    items={[
      {
        title: '¿Qué son las plantillas de landing page?',
        description:
          'Las plantillas de landing page son diseños de páginas web predefinidos creados específicamente para servir como base para construir landing pages efectivas. Estas plantillas están diseñadas para captar la atención de los visitantes y guiarlos hacia una acción o meta específica, como suscribirse a un boletín, hacer una compra o descargar un recurso.',
      },
      {
        title: '¿Por qué debería usar una plantilla?',
        description:
          'Algunas ventajas son que proporcionan una estructura lista para usar, ahorrandote mucho tiempo. están diseñadas con facilidad de uso en mente y ofrecen una alternativa rentable, ahorrándote dinero mientras te entrega un resultado de calidad.',
      },
      {
        title: '¿Puedo ver una demostración antes de comprar?',
        description:
          'Sí, las plantillas te permiten ver una demostración antes de realizar la compra. Hay un botón "Demo" asociado con cada plantilla.',
      },
      {
        title: '¿Necesito habilidades técnicas para usar una plantilla?',
        description:
          'No se requieren habilidades técnicas avanzadas para usar una plantilla, pero tener un conocimiento básico de navegación web y familiaridad con el uso de herramientas en línea puede ser beneficioso. Si necesitas personalizaciones más específicas, podrías consultar guías o ponerte en contacto con el soporte al cliente para obtener ayuda.',
      },
      {
        title: '¿Puedo usar la plantilla en múltiples sitios web?',
        description:
          'No, la plantilla viene con una licencia de uso único, lo que significa que puedes usar la plantilla en un solo sitio web o proyecto únicamente. Usar la plantilla en sitios web adicionales requeriría comprar licencias adicionales.',
      },
      {
        title: '¿Qué hago si necesito ayuda con la personalización?',
        description:
          'Las plantillas incluyen una guía completa paso a paso que te guía a través del proceso de personalización. Si aún tienes dudas, puedes ponerte en contacto con nuestro equipo de soporte al cliente. Ellos pueden responder tus preguntas, brindarte orientación sobre personalización y abordar cualquier problema que estés enfrentando.',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </FAQs>

  <!-- Features3 Widget ************** -->

  <Features3
    title="Háznos saber cómo podemos ayudarte"
    subtitle="Estamos aquí para ayudarte y responder cualquier pregunta que tengas."
    columns={4}
    items={[
      {
        title: 'Teléfono',
        icon: 'tabler:phone',
        callToAction: {
          target: '_blank',
          text: 'Llámanos',
          href: '/',
          variant: 'link',
        },
      },
      {
        title: 'Email',
        icon: 'tabler:mail',
        callToAction: {
          target: '_blank',
          text: 'Escríbenos',
          href: '/',
          variant: 'link',
        },
      },
      {
        title: 'Chat con ventas',
        icon: 'tabler:message-circle',
        callToAction: {
          target: '_blank',
          text: 'Chatear con ventas',
          href: '/',
          variant: 'link',
        },
      },
      {
        title: 'Chat con soporte',
        icon: 'tabler:message-circle',
        callToAction: {
          target: '_blank',
          text: 'Chatear con soporte',
          href: '/',
          variant: 'link',
        },
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Explorar plantillas',
        href: '#',
        icon: 'tabler:download',
      },
    ]}
  >
    <Fragment slot="title">Sé parte de nuestra visión</Fragment>

    <Fragment slot="subtitle">
      Descubre un entorno laboral dinámico, oportunidades de crecimiento insuperables y la oportunidad de tener un impacto significativo.
    </Fragment>
  </CallToAction>
</Layout>
