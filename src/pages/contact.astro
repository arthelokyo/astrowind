---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contacto — Pronto',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contacto" title="Hablemos" />

  <ContactUs
    id="form"
    title="Escríbenos"
    subtitle="¿Tienes dudas sobre Pronto? Cuéntanos cómo podemos ayudarte y te responderemos a la brevedad."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Nombre',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Correo electrónico',
      },
    ]}
    textarea={{
      label: 'Mensaje',
    }}
    disclaimer={{
      label: 'Al enviar este formulario, aceptas la recolección de tu información personal.',
    }}
    description="Nuestro equipo responde en menos de 24 horas hábiles."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Estamos aquí para ayudarte"
    items={[
      {
        title: 'Soporte general',
        description: `Dudas sobre tu cuenta, configuración del catálogo, gestión de pedidos o cualquier pregunta sobre Pronto.`,
      },
      {
        title: 'Ventas',
        description:
          '¿Quieres saber más sobre planes, precios o funciones? Te contamos todo lo que Pronto puede hacer por tu negocio.',
      },
      {
        title: 'Soporte técnico',
        description:
          'Problemas con la app, errores al crear tu catálogo, tracking de pedidos o cualquier tema técnico.',
      },
      {
        title: 'WhatsApp',
        description: '+52 55 1234 5678',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Email',
        description: 'hola@pronto.app',
        icon: 'tabler:mail',
      },
      {
        title: 'Ubicación',
        description: 'Ciudad de México, México',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
