import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Nosotros',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Nosotros"
    image={{
      //src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Integrantes del equipo de trabajo de la Fundación Plantemos',
    }}
  >
    <Fragment slot="title">
      Queremos que sepas<br />
      <span class="text-accent dark:text-white highlight"> quienes somos y porqué lo hacemos</span>
    </Fragment>

    <Fragment slot="subtitle">
      La Fundación Plantemos es una entidad sin ánimo de lucro, de carácter ambiental y socio cultural, que desde el año
      2020 viene desarrollando actividades de protección, conservación y restauración de ecosistemas naturales en la
      Región del Sumapaz, así como acciones encaminadas a la educación ambiental, la soberanía alimentaria y el
      ecoturismo rural y comunitario.
    </Fragment>
  </Hero>

  <YouTube id="https://www.youtube.com/watch?v=-r6w3AmDMNY" class="mx-auto" />

  <!-- Stats Widget ****************** -->

  <Stats
    title="A la fecha hemos logrado"
    subtitle="intervenir Fusagasugá, Arbeláez, Pasca, Pandi, Silvania, Tibacuy y Viotá."
    stats={[
      { title: 'Arboles sembrados', amount: '+3200' },
      { title: 'Reforestaciones', amount: '+26' },
      { title: 'Voluntarios', amount: '+300' },
      { title: 'Años recuperando ecosistemas', amount: '+5' },
    ]}
  />

