---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Sobre Pronto — La plataforma que digitaliza tu negocio',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Sobre nosotros"
    image={{
      src: 'https://images.unsplash.com/photo-1559136555-9303baea8ebd?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Equipo Pronto',
    }}
  >
    <Fragment slot="title">
      Ayudamos a pequeños negocios a <br />
      <span class="text-accent dark:text-white"> vender más por WhatsApp</span>
    </Fragment>

    <Fragment slot="subtitle">
      En Pronto creemos que la tecnología debe ser simple y accesible. Creamos una plataforma que permite a cualquier
      negocio tener un catálogo digital, recibir pedidos por WhatsApp y hacer seguimiento en tiempo real. Todo desde el
      celular, sin complicaciones.
    </Fragment>
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Pronto en cifras"
    stats={[
      { title: 'Pedidos gestionados', amount: '12.5K' },
      { title: 'Negocios activos', amount: '500+' },
      { title: 'Productos catalogados', amount: '15K+' },
      { title: 'Países', amount: '5' },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="¿Para quién es Pronto?"
    subtitle="Pronto está diseñado para pequeños y medianos negocios que quieren digitalizar su operación y vender más por WhatsApp sin complicaciones."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Restaurantes y comida',
        description:
          'Restaurantes, pizzerías, cafeterías, heladerías y cualquier negocio de comida que quiera recibir pedidos por WhatsApp con un catálogo digital actualizado.',
        icon: 'tabler:building-store',
      },
      {
        title: 'Tiendas y comercios',
        description:
          'Tiendas de ropa, regalos, florerías, ferreterías y cualquier comercio que quiera mostrar su catálogo y recibir pedidos desde el celular de sus clientes.',
        icon: 'tabler:shopping-bag',
      },
      {
        title: 'Servicios locales',
        description:
          'Servicios de delivery, catering, repostería, y emprendedores que quieran ofrecer una experiencia profesional a sus clientes sin tener página web.',
        icon: 'tabler:star',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    columns={3}
    isAfterContent={true}
    items={[
      {
        title: 'Catálogo con IA',
        description:
          'Sube una foto de tu menú impreso y Pronto genera el catálogo completo con precios y descripciones. En 5 minutos tienes tu menú digital listo.',
        icon: 'tabler:camera',
      },
      {
        title: 'Pedidos por WhatsApp',
        description: 'Cada pedido llega directo a la app con confirmación SMS. Todo organizado sin perder detalle.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Tracking en tiempo real',
        description: 'Tus clientes siguen su pedido paso a paso con URL de seguimiento y mapa en vivo del repartidor.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'App de repartidores',
        description:
          'Mapa integrado con la mejor ruta para tus entregas a domicilio. El cliente también ve la ubicación en tiempo real.',
        icon: 'tabler:truck-delivery',
      },
      {
        title: 'Validación SMS',
        description: 'Código de confirmación único para cada pedido. Adiós a los fraudes y pedidos falsos.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Estadísticas',
        description: 'Conoce tus productos más vendidos, horarios pico y el crecimiento de tu negocio.',
        icon: 'tabler:chart-bar',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Colorful Image',
    }}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestros valores"
    subtitle="Creemos en la tecnología simple, accesible y que realmente ayude a los pequeños negocios a crecer."
    items={[
      {
        title: 'Simplicidad',
        description:
          'La tecnología no tiene que ser complicada. Diseñamos Pronto para que cualquier persona pueda usarlo desde el primer minuto, sin manuales ni capacitación.',
      },
      {
        title: 'Accesibilidad',
        description:
          'Creemos que todos los negocios merecen herramientas digitales profesionales, sin importar su tamaño. Por eso ofrecemos precios justos y sin comisiones ocultas.',
      },
      {
        title: 'Compromiso con el cliente',
        description:
          'Cada decisión que tomamos está pensada para ayudar a nuestros usuarios a vender más. Su éxito es nuestro éxito.',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Nuestros logros"
    subtitle="En poco tiempo hemos ayudado a cientos de negocios a dar el salto digital."
    isReversed={true}
    callToAction={{
      text: 'Ver más',
      href: '/',
    }}
    items={[
      {
        title: 'Presencia en 5 países',
        description:
          'México, Colombia, Perú, Chile y Argentina. Seguimos expandiéndonos para llegar a más negocios en Latinoamérica.',
        icon: 'tabler:globe',
      },
      {
        title: 'Más de 12.500 pedidos gestionados',
        description:
          'Nuestra plataforma ha procesado más de 12.500 pedidos con una tasa de satisfacción del 98%. Cada pedido validado con SMS anti-fraude.',
        icon: 'tabler:message-star',
      },
      {
        title: '500+ negocios activos',
        description:
          'Restaurantes, tiendas y emprendedores confían en Pronto para digitalizar su negocio y vender más por WhatsApp.',
        icon: 'tabler:award',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Estamos en Latinoamérica"
    tagline="Presencia"
    columns={4}
    items={[
      {
        title: 'México',
        icon: 'tabler:map-pin',
        description: 'Ciudad de México',
      },
      {
        title: 'Colombia',
        icon: 'tabler:map-pin',
        description: 'Bogotá',
      },
      {
        title: 'Perú',
        icon: 'tabler:map-pin',
        description: 'Lima',
      },
      {
        title: 'Argentina',
        icon: 'tabler:map-pin',
        description: 'Buenos Aires',
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Soporte técnico"
    tagline="Contacto"
    columns={2}
    items={[
      {
        title: 'Chat en vivo',
        description: 'Chatea con nuestro equipo de soporte en horario laboral. Respondemos en menos de 5 minutos.',
        icon: 'tabler:messages',
      },
      {
        title: 'Email',
        description: 'Escríbenos a soporte@pronto.app y te responderemos en menos de 24 horas hábiles.',
        icon: 'tabler:mail',
      },
    ]}
  />
</Layout>
