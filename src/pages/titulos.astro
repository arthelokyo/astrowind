    rvoeHref: 'https://drive.google.com/file/d/169xCYgFR8W7klrXbjUEWoEBAr_qC0BmM/view',
  },
  {
    level: 'Doctorado en',
    name: 'Energías Renovables',
    href: '/phd/energias-renovables',
    rvoe: 'RVOE N° DOC201106',
    rvoeHref: 'https://drive.google.com/file/d/1MKTcg2g28JQG7SoJBya7xFatEXcozG9d/view',
  },
  {
    level: 'Doctorado en',
    name: 'Ecoturismo y Turismo Sostenible',
    href: '/phd/ecoturismo-turismo-sostenible',
    rvoe: 'RVOE N° DOC201210',
    rvoeHref: 'https://drive.google.com/file/d/1IfXM914_S0U8U_rqQAbizsWk4tp5vNLq/view',
  },
  {
    level: 'Doctorado en',
    name: 'Urbanismo y Arquitectura Sostenible',
    href: '/phd/urbanismo-arquitectura-sostenible',
    rvoe: 'RVOE N° DOC210103',
    rvoeHref: 'https://drive.google.com/file/d/1AyHx-KKqeBU488F6cQYQmdtoW_ebQ5m_/view',
  },
  {
    level: 'Doctorado en',
    name: 'Administración de Negocios Sostenibles',
    href: '/phd/administracion-negocios-sostenibles',
    rvoe: 'RVOE N° DOC201107',
    rvoeHref: 'https://drive.google.com/file/d/12S4o_45AYCKZNpws1z8Eh-V8k1sSUHON/view',
  },
  {
    level: 'Doctorado en',
    name: 'Conservación y Restauración del Medio Natural',
    href: '/phd/conservacion-restauracion-medio-natural',
    rvoe: 'RVOE N° DOC170202',
    rvoeHref: 'https://drive.google.com/file/d/1P4it7MhY5N-LuLMJimhW605tPOzJt8ta/view',
