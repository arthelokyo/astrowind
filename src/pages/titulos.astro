  },
  {
    level: 'Maestría en',
    name: 'Sostenibilidad Turística y Ecoturismo',
    href: '/maestria/sostenibilidad-turistica-ecoturismo',
    rvoe: 'RVOE N° MAES201008',
    rvoeHref: 'https://drive.google.com/file/d/1Mo1lN8G3xVeu4RbVNVAk8MhCSprwd8VL/view',
  },
  {
    level: 'Maestría en',
    name: 'Eficiencia Energética y Sostenibilidad',
    href: '/maestria/eficiencia-energetica-cambio-climatico-sostenibilidad',
    rvoe: 'RVOE N° MAES201009',
    rvoeHref: 'https://drive.google.com/file/d/1zgpPqW0ApZ0hgP7_aOaWiN9DZb2_Ts8f/view',
  },
  {
    level: 'Maestría en',
    name: 'Hábitat, Urbanismo y Edificación Sostenible',
    href: '/maestria/habitat-urbanismo-edificacion-sostenible',
    rvoe: 'RVOE N° MAES201239',
    rvoeHref: 'https://drive.google.com/file/d/1O4FTTr0hL-oVd0gUsWOcrPqF_VZmcOSl/view',
  },
];

const programGroups = [
  {
    title: 'Doctorados',
    programs: programs.filter(({ level }) => level === 'Doctorado en'),
  },
  {
    title: 'Maestrías',
    programs: programs.filter(({ level }) => level === 'Maestría en'),
  },
];
---

<Layout metadata={metadata}>
  <Hero tagline="Titulación">
    <Fragment slot="title">
      Títulos oficiales y
      <span class="text-primary dark:text-accent"> reconocimiento académico</span>
    </Fragment>
    <Fragment slot="subtitle">
      <strong class="text-primary dark:text-accent">Fondo Verde Institute</strong> imparte programas de estudios en español
      y 100 % online, ofrecidos por la
      <a
        href="https://www.unicepes.edu.mx/"
        target="_blank"
        rel="noreferrer"
        class="font-semibold text-primary decoration-primary/40 underline-offset-4 hover:decoration-primary dark:text-accent"
      >
        Universidad Centro Panamericano de Estudios Superiores (UNICEPES)
      </a>
      de México.<br /><br />

      Las personas que cursen y finalicen con éxito un programa en <strong class="text-primary dark:text-accent"
        >Fondo Verde Institute</strong
      > recibirán un
      <strong class="text-primary dark:text-accent">Título Oficial</strong> de
      <a
        href="https://www.unicepes.edu.mx/"
        target="_blank"
        rel="noreferrer"
        class="font-semibold text-primary decoration-primary/40 underline-offset-4 hover:decoration-primary dark:text-accent"
      >
        UNICEPES
      </a>. La universidad ha obtenido los acuerdos de <strong class="text-secondary"
        >Reconocimiento de Validez Oficial de Estudios</strong
      > (<strong class="text-secondary">RVOE</strong>) para sus programas de posgrado, incluidos en el <strong
        >Sistema Educativo Nacional</strong
      >. Por tanto, la <strong>Secretaría de Educación Pública (SEP)</strong> garantiza el reconocimiento internacional de
      nuestros títulos.
    </Fragment>
  </Hero>

  <section id="programas-con-rvoe" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <div class="mb-8 max-w-3xl">
        <p class="text-sm font-bold uppercase tracking-wider text-secondary">Programas de posgrado</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-default dark:text-white md:text-4xl">
          Reconocimiento de Validez Oficial de Estudios (RVOE)
        </h2>
        <p class="mt-4 text-lg text-muted dark:text-slate-300">
          Consulta el programa y accede al documento de reconocimiento correspondiente.
        </p>
      </div>

      <div
        class="hidden overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm dark:border-slate-700 dark:bg-slate-900 md:block"
      >
        <table class="w-full min-w-[840px] border-collapse text-left text-sm">
          <caption class="sr-only">Programas de posgrado de Fondo Verde Institute y sus documentos RVOE</caption>
          <thead class="bg-accent text-xs uppercase tracking-wider text-white">
            <tr>
              <th scope="col" class="w-[72%] whitespace-nowrap px-5 py-4">Programas de posgrado</th>
              <th scope="col" class="whitespace-nowrap px-5 py-4">Reconocimiento RVOE</th>
            </tr>
          </thead>
          {
            programGroups.map((group) => (
              <tbody class="divide-y divide-slate-300 dark:divide-slate-700">
                <tr>
                  <th
                    scope="rowgroup"
                    colspan="2"
                    class="border-y border-slate-300 bg-slate-200 px-5 py-3 text-left text-sm font-bold uppercase tracking-wider text-default dark:border-slate-700 dark:bg-slate-800 dark:text-white"
                  >
                    {group.title}
                  </th>
                </tr>
                {group.programs.map((program) => (
                  <tr class="align-top text-muted odd:bg-white even:bg-slate-100 dark:text-slate-300 dark:odd:bg-slate-900 dark:even:bg-slate-800">
                    <td class="whitespace-nowrap px-5 py-4">
                      <span class="mr-1 text-base font-semibold tracking-wide text-secondary">{program.level}</span>
                      <a
                        href={program.href}
                        class="text-base font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary dark:text-accent"
                      >
                        {program.name}
                      </a>
                    </td>
                    <td class="whitespace-nowrap px-5 py-4">
                      <a
                        href={program.rvoeHref}
                        target="_blank"
                        rel="noreferrer"
                        class="font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary dark:text-accent"
                        title={`Abrir documento ${program.rvoe}`}
                      >
                        {program.rvoe}
                        <span class="sr-only"> (abre en una pestaña nueva)</span>
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>

      <ul class="grid gap-4 md:hidden">
        {
          programGroups.map((group) => (
            <Fragment>
              <li class="col-span-full border-b border-slate-300 pb-2 pt-4 text-sm font-bold uppercase tracking-wider text-default dark:border-slate-700 dark:text-white">
                {group.title}
              </li>
              {group.programs.map((program) => (
                <li class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-700 dark:bg-slate-900">
                  <p class="text-lg font-bold tracking-wider text-secondary">{program.level}</p>
                  <h3 class="mt-2 text-lg font-bold leading-snug text-default dark:text-white">
                    <a
                      href={program.href}
                      class="text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary dark:text-accent"
                    >
                      {program.name}
                    </a>
                  </h3>
                  <div class="mt-4 border-t border-slate-200 pt-4 dark:border-slate-700">
                    <p class="text-xs font-semibold uppercase tracking-wide text-muted dark:text-slate-400">
                      Reconocimiento (RVOE)
                    </p>
                    <a
                      href={program.rvoeHref}
                      target="_blank"
                      rel="noreferrer"
                      class="mt-1 inline-flex font-semibold text-primary underline decoration-primary/30 underline-offset-4 hover:decoration-primary dark:text-accent"
                      title={`Abrir documento ${program.rvoe}`}
                    >
                      {program.rvoe}
                      <span class="sr-only"> (abre en una pestaña nueva)</span>
                    </a>
                  </div>
                </li>
              ))}
            </Fragment>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Hitos de Acreditación — versión Steps2 (comparativa) ************** -->
  <Steps2
    title="Hitos de acreditación y calidad"
    subtitle="A lo largo de los años, <strong>Fondo Verde Institute</strong> ha acumulado reconocimientos que certifican la excelencia de sus programas ante organismos nacionales e internacionales."
    colLeft="md:w-1/3"
    colRight="md:w-2/3"
    items={[
      {
        title: 'COMEPO — Miembro desde 2018',
        description:
          'En septiembre de 2018, UNICEPES fue aceptado como miembro del Consejo Mexicano de Estudios de Posgrados (COMEPO), el organismo de interlocución de los posgrados con CONACYT y la Subsecretaría de Educación Superior.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Certificación ISO 21001:2018 — Primera universidad privada en México',
        description:
          'En 2020, UNICEPES se convirtió en la primera universidad privada en México en recibir la certificación ISO 21001:2018, avalada por la Entidad Mexicana de Acreditación (EMA), el Foro Internacional de Acreditación (IAF) y la Organización Internacional de Normalización ISO.',
        icon: 'tabler:certificate',
      },
      {
        title: 'CIEES — Acreditación del Doctorado en Proyectos (2021)',
        description:
          'En junio de 2021, UNICEPES obtuvo la acreditación de los Comités Interinstitucionales para la Evaluación de la Educación Superior (CIEES) para el programa de Doctorado en Proyectos, verificando mediante 5 ejes, 12 categorías y 49 indicadores el cumplimiento de los propósitos formativos.',
        icon: 'tabler:medal',
      },
    ]}
  />
  
</Layout>
