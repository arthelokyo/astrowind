    name: 'Sostenibilidad',
    href: '/phd/sostenibilidad',
    rvoe: 'RVOE N° DOC160402',
    rvoeHref: 'https://drive.google.com/file/d/1aYrYNeZfaQ_eYuWcsx6Lrquty1ZhMHRG/view',
  },
  {
