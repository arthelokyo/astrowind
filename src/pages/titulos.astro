---
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Títulos oficiales y reconocimiento académico',
  description:
    'Conoce la titulación oficial de UNICEPES, los RVOE de los programas de posgrado y las acreditaciones institucionales.',
  keywords:
