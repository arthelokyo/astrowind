---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Prices from '~/components/widgets/Pricing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Steps from '~/components/widgets/Steps.astro';
import Features3 from '~/components/widgets/Features3.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Precios — Pronto',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Precios"
    title="Planes simples y transparentes"
    subtitle="Elige el plan perfecto para tu negocio. Sin sorpresas, sin comisiones ocultas."
  />

  <!-- Pricing Widget ******************* -->

  <Prices
    title="Nuestros planes"
    subtitle="Solo pagas por lo que necesitas"
    prices={[
      {
        title: 'básico',
        subtitle: 'Opción ideal para empezar',
        price: 29,
        period: 'por mes',
        items: [
          {
            description: 'Catálogo digital con IA',
          },
          {
            description: 'Pedidos por WhatsApp',
          },
          {
            description: 'Tracking en tiempo real',
          },
          {
            description: 'Sin comisiones por pedido',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Empezar ahora',
          href: '#',
        },
      },
      {
        title: 'estándar',
        subtitle: 'Ideal para negocios en crecimiento',
        price: 69,
        period: 'por mes',
        items: [
          {
            description: 'Todo del plan básico',
          },
          {
            description: 'Estadísticas de ventas',
          },
          {
            description: 'App de repartidores',
          },
          {
            description: 'Recoge en tienda o delivery',
          },
          {
            description: 'Validación SMS anti-fraude',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Empezar ahora',
          href: '#',
        },
        hasRibbon: true,
        ribbonTitle: 'popular',
      },
      {
        title: 'premium',
        subtitle: 'Para negocios que quieren más',
        price: 199,
        period: 'por mes',
        items: [
          {
            description: 'Todo del plan estándar',
          },
          {
            description: 'Soporte prioritario 24/7',
          },
          {
            description: 'Personalización de marca',
          },
          {
            description: 'Reportes avanzados',
          },
        ],
        callToAction: {
          target: '_blank',
          text: 'Empezar ahora',
          href: '#',
        },
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Características por plan"
    subtitle="Descubre las ventajas de elegir nuestros planes"
    columns={2}
    items={[
      {
        title: 'Planes escalonados',
        description: 'Elige entre una variedad de planes diseñados para diferentes tipos de negocios y presupuestos.',
        icon: 'tabler:stairs',
      },
      {
        title: 'Precios transparentes',
        description: 'Costos claramente mostrados en cada plan, sin costos ocultos ni cargos inesperados.',
        icon: 'tabler:flip-vertical',
      },
      {
        title: 'Pagos seguros',
        description: 'Métodos de pago seguros para proteger tu información financiera.',
        icon: 'tabler:shield-lock',
      },
      {
        title: 'Acceso inmediato',
        description: 'Acceso inmediato a todas las características del plan seleccionado al suscribirte.',
        icon: 'tabler:accessible',
      },
      {
        title: 'Mejor valor',
        description: 'Actualiza a planes superiores para desbloquear más funciones y beneficios.',
        icon: 'tabler:chevrons-up',
      },
      {
        title: 'Soporte 24H',
        description: 'Preguntas respondidas por chat en vivo, email o teléfono, todos los días.',
        icon: 'tabler:headset',
      },
    ]}
    classes={{ container: 'max-w-5xl' }}
  />

  <!-- Steps Widget ****************** -->

  <Steps
    title="Tu camino desde el plan hasta el éxito"
    tagline="Proceso simplificado"
    isReversed={true}
    items={[
      {
        title: 'Explora los planes',
        icon: 'tabler:number-1',
      },
      {
        title: 'Selecciona tu plan',
        icon: 'tabler:number-2',
      },
      {
        title: 'Regístrate o inicia sesión',
        icon: 'tabler:number-3',
      },
      {
        title: 'Revisa tu pedido',
        icon: 'tabler:number-4',
      },
      {
        title: 'Ingresa tus datos de pago',
        icon: 'tabler:number-5',
      },
      {
        title: 'Confirmación',
        icon: 'tabler:number-6',
      },
      {
        title: 'Comienza a usar Pronto',
        icon: 'tabler:number-7',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1536816579748-4ecb3f03d72a?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Pasos para suscribirte',
    }}
  />

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas frecuentes sobre precios"
    subtitle="Elegir el plan correcto es importante, y estamos aquí para responder tus preguntas."
    columns={1}
    items={[
      {
        title: '¿Los planes incluyen soporte al cliente?',
        description:
          'Absolutamente. Todos los planes incluyen acceso a nuestro equipo de soporte dedicado para ayudarte con cualquier duda.',
      },
      {
        title: '¿Hay un periodo de prueba para los planes?',
        description:
          'Actualmente no ofrecemos periodos de prueba. Sin embargo, puedes ver nuestro catálogo de ejemplo para evaluar la calidad de nuestra plataforma.',
      },
      {
        title: '¿Puedo cambiar entre planes?',
        description:
          '¡Claro! Puedes subir o bajar de plan en cualquier momento para encontrar el que mejor se adapte a tus necesidades.',
      },
      {
        title: '¿Qué métodos de pago aceptan?',
        description:
          'Aceptamos tarjetas de crédito principales y métodos de pago en línea para garantizar un proceso seguro y conveniente.',
      },
      {
        title: '¿Hay costos ocultos aparte del precio mostrado?',
        description:
          'No. El costo de suscripción cubre todas las características mostradas en cada plan. No hay costos ocultos ni cargos adicionales.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="¿Listo para aumentar tus ventas?"
    subtitle="Únete a cientos de negocios que ya usan Pronto para digitalizar su operación y vender más por WhatsApp."
    actions={[
      {
        variant: 'primary',
        text: 'Empezar ahora',
        href: '/',
      },
    ]}
  />
</Layout>
