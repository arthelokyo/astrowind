---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Pronto — Catálogo digital y gestión de pedidos para tu negocio',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Crear mi catálogo gratis',
        href: '#features',
        icon: 'tabler:smart-home',
      },
      { text: 'Ver cómo funciona', href: '#features' },
    ]}
    image={{ src: '~/assets/images/hero-image.png', alt: 'Pronto Hero Image' }}
  >
    <Fragment slot="title">
      Transforma tu negocio con un <span class="hidden xl:inline">catálogo digital</span>
      <span class="text-accent dark:text-white"> en 5 minutos</span>
    </Fragment>

    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold">Pronto</span> es la plataforma que ayuda a pequeños negocios a vender más por WhatsApp.
        Tus clientes piden desde un catálogo virtual, reciben confirmación SMS y siguen su pedido en tiempo real.</span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">Pronto: Vende más por WhatsApp.</span>
      Crea tu menú digital con IA. Sin comisiones. Sin complicaciones.
    </Fragment>
  </Hero>

  <!-- Note Widget ******************* -->

  <Note title="Pronto SaaS:" description="La forma más fácil de recibir pedidos por WhatsApp" />

  <!-- Features Widget *************** -->

  <Features
    id="features"
    tagline="Características"
    title="Todo lo que necesitas para vender más"
    subtitle="Pronto te da las herramientas para digitalizar tu negocio en minutos. Tus clientes piden desde el celular, sin descargar nada."
    items={[
      {
        title: 'Catálogo con IA',
        description:
          'Sube una foto de tu menú impreso y Pronto genera automáticamente el catálogo completo con precios y descripciones. Crea tu menú digital en 5 minutos.',
        icon: 'tabler:camera',
      },
      {
        title: 'Gestión de productos',
        description:
          'Agrega, edita, elimina o desactiva productos desde la app. Todos los cambios se reflejan en tiempo real en el catálogo de tus clientes.',
        icon: 'tabler:settings',
      },
      {
        title: 'Pedidos por WhatsApp',
        description:
          'Cada pedido llega directo a tu app con confirmación vía SMS. Recibe notificaciones al instante y nunca pierdas una venta.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Tracking en tiempo real',
        description:
          'Tus clientes reciben una URL para seguir su pedido paso a paso: Confirmado → Aceptado → En preparación → En reparto. Con mapa incluido.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Recoge en tienda, a domicilio o en sitio',
        description:
          'Ofrece a tus clientes la flexibilidad de elegir cómo quieren recibir su pedido. Tú controlas las opciones desde la app.',
        icon: 'tabler:building-store',
      },
      {
        title: 'App de repartidores con mapa',
        description:
          'Cuando el pedido es a domicilio, tu repartidor ve la ruta en el mapa. El cliente también puede ver la ubicación en tiempo real desde su tracking.',
        icon: 'tabler:map-2',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    tagline="Cómo funciona"
    title="De tu negocio a tus clientes en 3 pasos"
    items={[
      {
        title: 'Crea tu catálogo en 5 minutos',
        description:
          'Toma una foto a tu menú impreso o súbelo desde tu celular. La IA de Pronto genera automáticamente precios, descripciones y categorías. Sin escribir nada.',
      },
      {
        title: 'Comparte con tus clientes',
        description:
          'Reciben un link o código QR por WhatsApp. Pueden ver tu catálogo completo, elegir productos y hacer su pedido al instante. Sin descargar nada.',
      },
      {
        title: 'Gestiona pedidos al instante',
        description:
          'Los pedidos llegan a la app con validación SMS. Aceptas, preparas y el cliente recibe tracking en tiempo real con mapa de seguimiento.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Cómo funciona Pronto',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Digitaliza tu negocio en minutos
      </h3>
      Más de 100 pequeños negocios ya venden más con Pronto
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Aumenta tus ventas por WhatsApp',
        description: `Tus clientes pueden hacer pedidos desde la comodidad de su casa con solo abrir un link. Más fácil que nunca.`,
      },
      {
        title: 'Sin comisiones por pedido',
        description:
          'Paga solo una tarifa fija mensual. Sin comisiones ocultas. Todas las ganancias de tus ventas son para ti.',
      },
      {
        title: 'Tus clientes no necesitan descargar nada',
        description:
          'Todo funciona desde el navegador web. Compartes un link o código QR y ya pueden pedir. Sin apps, sin registros.',
      },
      {
        title: 'Actualiza tu catálogo al instante',
        description:
          'Agregas un producto, cambias un precio o descuentas algo. Se refleja al segundo en el catálogo de todos tus clientes.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Vende más con Pronto',
    }}
  >
    <Fragment slot="content">Diseñado para que vendas más, sin complicaciones.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isReversed
    isAfterContent
    items={[
      {
        title: 'Validación SMS anti-fraude',
        description:
          'Cada pedido se confirma con un código SMS único. Evita pedidos falsos y clientes fantasma. Solo pedidos reales.',
      },
      {
        title: 'Notificaciones en tiempo real',
        description:
          'Recibe una alerta al instante cuando llega un pedido nuevo. Nunca más pierdas una venta por no revisar a tiempo.',
      },
      {
        title: 'App de repartidores incluida',
        description:
          'Cuando ofreces delivery, tu repartidor usa la app con mapa integrado y la mejor ruta. El cliente también ve el mapa en su tracking.',
      },
      {
        title: 'Estadísticas de ventas',
        description: `Sabes cuánto vendes, qué productos son los más populares y en qué horarios recibes más pedidos. Datos para hacer crecer tu negocio.`,
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Pronto App',
    }}
  >
    <Fragment slot="content">Todo lo que necesitas para vender más, en un solo lugar.</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Steps Widget ****************** -->

  <Steps
    title="Empieza a vender más por WhatsApp en minutos"
    items={[
      {
        title: 'Paso 1: <span class="font-medium">Toma una foto a tu menú</span>',
        description:
          'La IA de Pronto crea el catálogo digital automáticamente con precios, descripciones y fotos. No necesitas escribir nada. Listo en 5 minutos.',
        icon: 'tabler:camera',
      },
      {
        title: 'Paso 2: <span class="font-medium">Comparte el link</span>',
        description:
          'Envía el enlace a tus clientes por WhatsApp. Pueden ver el catálogo completo y hacer su pedido al instante. Sin descargar nada.',
        icon: 'tabler:share',
      },
      {
        title: 'Paso 3: <span class="font-medium">Recibe pedidos y haz seguimiento</span>',
        description:
          'Los pedidos llegan a la app con confirmación SMS. Gestionas, preparas y el cliente recibe tracking en tiempo real con mapa.',
        icon: 'tabler:checklist',
      },
      {
        title: '¡A vender!',
        icon: 'tabler:check',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1616198814651-e71f960c3180?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=987&q=80',
      alt: 'Pasos para crear tu catálogo digital',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Todo lo que incluye Pronto"
    subtitle="Una solución completa para digitalizar tu negocio y vender más por WhatsApp"
    tagline="Funcionalidades"
    items={[
      {
        title: 'Catálogo con IA',
        description:
          'Sube una foto de tu menú impreso y Pronto genera el catálogo completo con precios y descripciones.',
        icon: 'tabler:camera',
      },
      {
        title: 'Pedidos por WhatsApp',
        description: 'Cada pedido llega directo a la app con confirmación SMS. Todo organizado sin perder detalle.',
        icon: 'tabler:brand-whatsapp',
      },
      {
        title: 'Tracking en tiempo real',
        description: 'Tus clientes siguen su pedido paso a paso con URL de seguimiento y mapa en vivo del repartidor.',
        icon: 'flat-color-icons:globe',
      },
      {
        title: 'Gestión de productos',
        description: 'Agrega, edita, elimina o desactiva productos. Se actualiza al instante en el catálogo.',
        icon: 'flat-color-icons:settings',
      },
      {
        title: 'App de repartidores',
        description: 'Mapa integrado con la mejor ruta para tus entregas a domicilio. El cliente también ve el mapa.',
        icon: 'flat-color-icons:in-transit',
      },
      {
        title: 'Recoge en tienda o delivery',
        description: 'Ofrece recoger en tienda, delivery o pedidos en sitio. Tú decides cómo vender.',
        icon: 'flat-color-icons:shop',
      },
      {
        title: 'Validación SMS',
        description: 'Código de confirmación único para cada pedido. Adiós a los fraudes y pedidos falsos.',
        icon: 'flat-color-icons:phone',
      },
      {
        title: 'Sin descargas para clientes',
        description: 'Tus clientes piden desde el navegador. Solo compartes un link por WhatsApp y listo.',
        icon: 'flat-color-icons:link',
      },
      {
        title: 'Estadísticas de ventas',
        description: 'Conoce tus productos más vendidos, horarios pico y el crecimiento de tu negocio.',
        icon: 'flat-color-icons:statistics',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- FAQs Widget ******************* -->

  <FAQs
    title="Preguntas Frecuentes"
    subtitle="Resuelve tus dudas sobre cómo Pronto puede ayudar a tu negocio a vender más por WhatsApp."
    tagline="FAQs"
    classes={{ container: 'max-w-6xl' }}
    items={[
      {
        title: '¿Cómo funciona Pronto?',
        description:
          'Pronto es una plataforma de catálogo digital y gestión de pedidos. Tomas una foto a tu menú impreso, la IA genera el catálogo automáticamente, compartes un link con tus clientes y ellos pueden hacer pedidos desde WhatsApp. Tú recibes y gestionas todo desde la app.',
      },
      {
        title: '¿Mis clientes necesitan descargar una app?',
        description:
          'No. Tus clientes solo necesitan abrir el link que les envías por WhatsApp. Todo funciona desde el navegador de su celular. Sin descargas, sin registros, sin complicaciones.',
      },
      {
        title: '¿Cómo se crea el catálogo con IA?',
        description:
          'Subes una foto de tu menú físico impreso (una carta, un pizarrón, un folleto) y la inteligencia artificial de Pronto extrae automáticamente los productos, precios y descripciones. En 5 minutos tienes tu catálogo digital listo.',
      },
      {
        title: '¿Qué opciones de entrega puedo ofrecer?',
        description:
          'Puedes ofrecer recoger en tienda, entrega a domicilio o pedidos para consumir en el sitio. Tú activas las opciones que quieras desde la app y el cliente elige al hacer su pedido.',
      },
      {
        title: '¿Cómo funciona el tracking para el cliente?',
        description:
          'Cuando confirmas un pedido, el cliente recibe una URL de seguimiento. Puede ver en tiempo real el estado: Confirmado, Aceptado, En preparación, En reparto. Si es delivery, también ve el mapa con la ubicación del repartidor.',
      },
      {
        title: '¿Cómo se validan los pedidos?',
        description:
          'Cada pedido se confirma mediante un código SMS que enviamos al cliente. Esto asegura que el pedido es real y evita fraudes o pedidos falsos. Solo recibes pedidos validados.',
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <Stats
    stats={[
      { title: 'Pedidos gestionados', amount: '12.5K' },
      { title: 'Negocios activos', amount: '500+' },
      { title: 'Productos catalogados', amount: '15K+' },
      { title: 'WhatsApp enviados', amount: '8K+' },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Crear mi catálogo gratis',
        href: '#features',
        icon: 'tabler:smart-home',
      },
    ]}
  >
    <Fragment slot="title">
      Pronto&nbsp;+&nbsp;<br class="block sm:hidden" /><span class="sm:whitespace-nowrap">WhatsApp</span>
    </Fragment>

    <Fragment slot="subtitle">
      Empieza hoy a recibir pedidos por WhatsApp. <br class="hidden md:inline" />Crea tu catálogo digital en 5 minutos
      con IA.
    </Fragment>
  </CallToAction>
</Layout>
