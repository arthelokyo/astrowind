---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import WhatIsPhycocyanin from '~/components/widgets/WhatIsPhycocyanin.astro';
import Benefits from '~/components/widgets/Benefits.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import ProductHighlight from '~/components/widgets/ProductHighlight.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Newsletter from '~/components/widgets/Newsletter.astro';

const metadata = {
  title: 'Phycocyanine - Guide complet sur le pigment bleu de la spiruline',
  description: 'Découvrez la phycocyanine, le pigment bleu aux propriétés antioxydantes. Guide complet, conseils d\'achat et sélection de produits de qualité.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <Hero
    actions={[
      {
        variant: 'primary',
        text: 'Découvrir le guide',
        href: '/guide',
      },
      {
        text: 'Voir les produits →',
        href: '/produits',
      },
    ]}
  >
    <Fragment slot="title">
      La Phycocyanine
    </Fragment>

    <Fragment slot="subtitle">
      Le guide complet sur le pigment bleu aux propriétés antioxydantes
    </Fragment>
  </Hero>

  <!-- Section "Qu'est-ce que la phycocyanine" -->
  <WhatIsPhycocyanin />

  <!-- Section 3 bénéfices clés -->
  <Benefits />

  <!-- Derniers articles du blog -->
  <BlogLatestPosts
    title="Nos derniers articles"
    information="Découvrez nos guides et conseils pour tout savoir sur la phycocyanine"
  />

  <!-- Produit recommandé -->
  <ProductHighlight />

  <!-- FAQ -->
  <FAQs
    title="Questions fréquentes"
    subtitle="Tout ce que vous devez savoir sur la phycocyanine"
    columns={1}
    items={[
      {
        title: 'Qu\'est-ce que la phycocyanine ?',
        description:
          'La phycocyanine est un pigment bleu naturel extrait de la spiruline. C\'est un puissant antioxydant qui contribue à protéger les cellules contre le stress oxydatif. Elle est particulièrement appréciée pour ses propriétés bénéfiques sur la santé et le bien-être général.',
      },
      {
        title: 'Quelle différence avec la spiruline ?',
        description:
          'La spiruline est une microalgue complète contenant protéines, vitamines et minéraux. La phycocyanine est un extrait concentré de cette algue, qui isole spécifiquement le pigment bleu. Elle permet de bénéficier des propriétés antioxydantes de la spiruline sous une forme plus concentrée et biodisponible.',
      },
      {
        title: 'Comment choisir sa phycocyanine ?',
        description:
          'Privilégiez une phycocyanine issue de spiruline cultivée en bassins contrôlés, certifiée bio si possible. Vérifiez la concentration (au moins 20-25 mg/ml), le mode d\'extraction (à froid pour préserver les propriétés) et la provenance. La forme liquide est généralement plus biodisponible que les gélules.',
      },
      {
        title: 'Y a-t-il des effets secondaires ?',
        description:
          'La phycocyanine est généralement bien tolérée. Toutefois, comme pour tout complément, il est recommandé de commencer par de petites doses. Les personnes allergiques aux algues ou sous traitement médical devraient consulter un professionnel de santé avant utilisation.',
      },
      {
        title: 'Quelle posologie recommandée ?',
        description:
          'La posologie habituelle se situe entre 10 et 20 ml par jour pour la forme liquide, de préférence le matin à jeun. Il est conseillé de commencer progressivement et d\'adapter selon votre ressenti. Respectez toujours les recommandations du fabricant et consultez un professionnel si nécessaire.',
      },
    ]}
  />

  <!-- Newsletter -->
  <Newsletter />
</Layout>
