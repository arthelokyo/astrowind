---
import Layout from '~/layouts/PageLayout.astro';
import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import ItemGrid from '~/components/ui/ItemGrid.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

const metadata = {
  title: 'TopMaklerWebsites',
  description:
    'Premium Makler-Websites für Agrar, Forst & Landwirtschaft – mobil schnell, filterstark und conversion-optimiert.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- 1) HERO -->
  <Hero
    id="hero"
    title="Makler-Websites, die auf dem Handy verkaufen."
    subtitle="Für Agrar, Forst & Landwirtschaft: mobil schnell, filterstark und conversion-optimiert – mit modularen Automationen für Anfragen, Exposé und Nachfassen."
    actions={[
      { variant: 'primary', text: 'Kostenlosen 7-Tage-Prototyp anfragen', href: '#kontakt' },
      { variant: 'secondary', text: 'Demo ansehen', href: '#demo' },
    ]}
  >
    <Fragment slot="content">
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-sm">
        {['Mobile-first', 'Performance-Fokus', 'Filterstark', 'Modular erweiterbar'].map((item) => (
          <span class="rounded-full border border-slate-200 dark:border-slate-700 bg-white/80 dark:bg-slate-900/70 px-3 py-1 text-slate-700 dark:text-slate-200 shadow-sm">
            {item}
          </span>
        ))}
      </div>
      <p class="mt-4 text-sm text-muted text-center">Kurzformular. Kein Risiko. Sie erhalten nach 7 Tagen eine klickbare Vorschau.</p>
    </Fragment>
  </Hero>

  <!-- 2) PHILOSOPHY BANNER -->
  <section class="relative bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 text-center text-lg font-semibold">
      Ich baue Websites als Vertriebssystem – nicht als Visitenkarte.
    </div>
  </section>

  <!-- 3) PROBLEM/LÖSUNG -->
  <WidgetWrapper id="loesung" containerClass="max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2 items-start">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-heading">
          Die meisten Makler-Websites verlieren Leads, bevor die Anfrage entsteht.
        </h2>
        <ul class="mt-6 space-y-3 text-lg text-muted">
          <li>Mobil zu langsam → Absprung</li>
          <li>Filter/Objektfindung zu schwach → Frust</li>
          <li>Anfragen unstrukturiert → Leads versanden</li>
        </ul>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm">
        <p class="text-lg text-slate-700 dark:text-slate-300 leading-relaxed">
          Eine moderne Makler-Website ist kein Design-Projekt. Sie ist der erste Schritt im Verkaufsprozess – und
          entscheidet, ob Interessenten bleiben, filtern und anfragen.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 4) FEATURES GRID -->
  <Features
    id="ergebnisse"
    title="Was sich nach dem Relaunch messbar verbessert"
    items={[
      {
        title: 'Mehr qualifizierte Anfragen',
        description: 'Durch bessere UX + Vorqualifizierung.',
        icon: 'tabler:user-check',
      },
      {
        title: 'Schnellere Reaktion',
        description: 'Durch Auto-Antworten & Routing.',
        icon: 'tabler:bolt',
      },
      {
        title: 'Weniger Admin-Zeit',
        description: 'Durch Exposé- und Follow-up-Automationen.',
        icon: 'tabler:clock',
      },
      {
        title: 'Mehr Abschlüsse',
        description: 'Weil weniger Leads verloren gehen.',
        icon: 'tabler:target',
      },
    ]}
    columns={2}
  />

  <!-- 5) FEATURES SECTION -->
  <Features2
    title="Ihr System in 15 Sekunden"
    items={[
      {
        title: 'Performance & Mobile UX',
        description: 'Schnelles Laden, klare Objektlogik, moderne Darstellung, perfekte Bedienbarkeit.',
        icon: 'tabler:device-mobile',
      },
      {
        title: 'Lead Engine',
        description: 'Anfrage-Flow in 60 Sekunden: Vorqualifizierung statt „Bitte Infos“.',
        icon: 'tabler:message-circle',
      },
      {
        title: 'Module im Abo',
        description: 'Exposé-PDF per Klick, Follow-ups, Tracking & Reporting – optional CRM-Sync.',
        icon: 'tabler:stack-2',
      },
    ]}
    columns={3}
  />

  <!-- ADD-ONS / BLUEPRINT -->
  <Content
    id="addons"
    isReversed
    tagline="Inside Template"
    title="AstroWind's Blueprint: Fun Meets Functionality!"
    subtitle="Add-ons, die Ihren Makler-Funnel erweitern – modular aktivierbar, ohne den Kern neu zu bauen."
    items={[
      {
        title: 'Exposé-Automation',
        description: 'PDF per Klick mit Markenlayout, Bildergalerie, Datenpunkte und Sharing-Link.',
      },
      {
        title: 'Lead-Routing & Auto-Reply',
        description: 'Sofort-Antwort mit Kontext, Zuordnung nach Region/Team und Übergabe an CRM.',
      },
      {
        title: 'Tracking & Reporting',
        description: 'Funnel-KPIs von Traffic bis Abschluss, klare Alerts bei Engpässen.',
      },
    ]}
    columns={1}
    image={{
      src: 'https://images.unsplash.com/photo-1523475472560-d2df97ec485c?auto=format&fit=crop&w=900&q=80',
      alt: 'Modulares Dashboard',
    }}
  >
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-300">
        Wählen Sie nur die Module, die Sie wirklich brauchen. Starten Sie mit dem Prototyp, aktivieren Sie Add-ons
        später – ohne Relaunch. Alles bleibt performant, mobil und klar strukturiert.
      </p>
    </Fragment>
  </Content>

  <!-- 6) CTA HIGHLIGHT -->
  <WidgetWrapper id="prototyp" containerClass="max-w-6xl">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900/90 bg-gradient-to-br from-white via-slate-50 to-amber-50 dark:from-slate-900 dark:via-slate-900 dark:to-slate-950 p-8 md:p-12 shadow-lg dark:shadow-[0_16px_60px_rgba(0,0,0,0.35)]">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_0.8fr] items-start">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-heading">
            Kostenloser Prototyp in 7 Tagen – damit Sie sofort sehen, wie es wirkt.
          </h2>
          <ul class="mt-6 space-y-3 text-lg text-muted">
            <li class="flex items-start gap-3">
              <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
              <span>Startseite (Positionierung + CTA)</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
              <span>Objekt-Übersichtsseite (modern, mobil, filterstark)</span>
            </li>
            <li class="flex items-start gap-3">
              <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
              <span>Objekt-Detailseite (klar, vertrauenswürdig, anfragebereit)</span>
            </li>
          </ul>
          <p class="mt-6 text-sm text-muted">
            Kein theoretisches Konzept – sondern ein echter, klickbarer Eindruck Ihrer neuen Website.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-950 p-6 shadow-sm dark:shadow-none">
          <div class="space-y-4">
            <Button variant="primary" href="#kontakt" class="w-full">Prototyp anfragen</Button>
            <p class="text-sm text-muted">Ergebnis nach 7 Tagen. Ohne Verpflichtung.</p>
          </div>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 7) FÜR WEN -->
  <WidgetWrapper id="fuer-wen" containerClass="max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2 items-center">
      <div class="relative rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-lg">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gray-500">
          Dashboard
        </div>
        <div class="mt-4 space-y-3">
          <div class="h-4 w-2/3 rounded-full bg-gray-200"></div>
          <div class="h-3 w-1/2 rounded-full bg-gray-200"></div>
          <div class="grid gap-3 md:grid-cols-2">
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4">
              <div class="mb-3 h-3 w-3/4 rounded-full bg-gray-200"></div>
              <div class="h-2 w-full rounded-full bg-gray-200"></div>
            </div>
            <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-4">
              <div class="mb-3 h-3 w-3/4 rounded-full bg-gray-200"></div>
              <div class="h-2 w-full rounded-full bg-gray-200"></div>
            </div>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-heading">
          Gemacht für Agrar/Forst-Makler mit erklärungsbedürftigen Objekten
        </h2>
        <ul class="mt-6 space-y-3 text-lg text-muted">
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Flächenlogik (ha, Nutzung, Besonderheiten)</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Dokumente/Unterlagen sauber integriert</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Portal-ähnliche UX statt „Broschüre“</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Ideal für Solo-Makler & Teams</span>
          </li>
        </ul>
        <p class="mt-6 text-lg text-muted">
          Je komplexer das Objekt, desto wichtiger ist eine Website, die strukturiert erklärt – und nicht verwirrt.
        </p>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 8) FEATURES LIST -->
  <WidgetWrapper containerClass="max-w-5xl">
    <Headline title="Modern heißt nicht „schön“. Modern heißt: schneller verkaufen." />
    <ItemGrid
      columns={1}
      defaultIcon="tabler:check"
      items={[
        { title: 'Objekt finden statt suchen (Filter + klare Struktur)' },
        { title: 'Mobil bedienbar ohne Frust (UX-first)' },
        { title: 'Anfragen mit Qualität statt Chaos (Step-Flow)' },
        { title: 'Prozesse, die nachfassen (automatisiert)' },
        { title: 'Erweiterbar ohne Relaunch (Module im Abo)' },
      ]}
      classes={{
        container: 'max-w-3xl mx-auto gap-y-6',
        panel: 'max-w-none',
        title: 'text-lg font-semibold',
        icon: 'text-primary bg-primary/10 rounded-full w-8 h-8 p-1.5 mr-3',
      }}
    />
  </WidgetWrapper>

  <!-- 9) ABLAUF -->
  <Steps
    id="ablauf"
    title="So läuft es ab – schnell, klar, ohne Agentur-Chaos"
    items={[
      {
        title: 'Kurz-Audit & Zielbild (Tag 1)',
        description:
          'Wir klären Zielgruppe, Objektarten, Engpässe und Wunsch-Outcome. Output: klare Empfehlung + Scope für Ihren Prototyp.',
      },
      {
        title: 'Prototyp-Umsetzung (Tag 2–7)',
        description:
          'Sie erhalten eine klickbare Vorschau mit Startseite, Objekt-Übersicht und Objekt-Detail. Output: Sie sehen sofort, wie Ihre neue Website wirkt.',
      },
      {
        title: 'Relaunch & Livegang (optional, danach)',
        description:
          'Wenn der Prototyp überzeugt: Umsetzung der kompletten Website + Module. Output: Relaunch + skalierbare Add-ons.',
      },
    ]}
  >
    <Fragment slot="image">
      <div class="relative h-full min-h-[320px] rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 md:bg-gradient-to-br md:from-white md:via-slate-50 md:to-amber-50 md:dark:bg-slate-900 p-6 shadow-lg">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gray-500">Timeline</div>
        <div class="mt-6 space-y-4">
          <div class="h-3 w-2/3 rounded-full bg-gray-200"></div>
          <div class="h-3 w-1/2 rounded-full bg-gray-200"></div>
          <div class="h-24 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900"></div>
          <div class="h-24 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900"></div>
        </div>
      </div>
    </Fragment>
    <Fragment slot="actions">
      <Button variant="primary" href="#kontakt">Prototyp anfragen</Button>
    </Fragment>
  </Steps>

  <!-- 10) PRICING -->
  <WidgetWrapper id="pakete" containerClass="max-w-7xl">
    <Headline title="Einstieg über Prototyp – danach wählen Sie das passende Paket" />
    <div class="grid gap-6 lg:grid-cols-3">
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm flex flex-col">
        <div class="text-sm font-semibold uppercase tracking-wider text-muted">Starter (Relaunch)</div>
        <p class="mt-3 text-lg text-muted">
          Für Solo-Makler, die modern auftreten und mehr Leads bekommen wollen.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          <li>Website-Relaunch (mobile-first)</li>
          <li>Objektseiten & Basisfilter</li>
          <li>Anfrage-Flow (vorqualifiziert)</li>
          <li>Performance + SEO-Basis</li>
        </ul>
        <div class="mt-6 text-lg font-semibold text-primary">Preis auf Anfrage</div>
        <p class="mt-4 text-sm text-muted">Ideal, wenn Ihre Website alt wirkt und mobil bremst.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm flex flex-col">
        <div class="text-sm font-semibold uppercase tracking-wider text-muted">Pro (Relaunch + Lead Engine)</div>
        <p class="mt-3 text-lg text-muted">
          Für Makler, die Leads konsequent in Gespräche verwandeln wollen.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          <li>Alles aus Starter</li>
          <li>Lead-Routing & Auto-Antworten</li>
          <li>Follow-up Sequenzen</li>
          <li>Exposé-Templates + PDF per Klick</li>
        </ul>
        <div class="mt-6 text-lg font-semibold text-primary">Preis auf Anfrage</div>
        <p class="mt-4 text-sm text-muted">Ideal, wenn Sie zu viel Zeit in Anfragen & Exposés verlieren.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-sm flex flex-col">
        <div class="text-sm font-semibold uppercase tracking-wider text-muted">Premium (System + Skalierung)</div>
        <p class="mt-3 text-lg text-muted">
          Für Teams und Bestandsmakler mit regelmäßigem Objektvolumen.
        </p>
        <ul class="mt-6 space-y-3 text-sm text-muted">
          <li>Alles aus Pro</li>
          <li>Rollen & Zuständigkeiten</li>
          <li>Reporting (Funnel: Traffic → Leads)</li>
          <li>Optional: CRM-Sync / Integrationen</li>
        </ul>
        <div class="mt-6 text-lg font-semibold text-primary">Preis auf Anfrage</div>
        <p class="mt-4 text-sm text-muted">Ideal, wenn Sie Prozesse standardisieren und skalieren wollen.</p>
      </div>
    </div>
    <p class="mt-8 text-center text-sm text-muted">
      Die Pakete sind modular – Sie zahlen nur, was Sie wirklich nutzen.
    </p>
  </WidgetWrapper>

  <!-- 11) DEMO -->
  <WidgetWrapper id="demo" containerClass="max-w-6xl">
    <div class="grid gap-10 lg:grid-cols-2 items-center">
      <div>
        <h2 class="text-3xl md:text-4xl font-bold tracking-tight text-heading">
          Sehen Sie es live – bevor Sie entscheiden
        </h2>
        <p class="mt-4 text-lg text-muted">
          In der Demo sehen Sie eine moderne, portal-ähnliche Objektliste, Filter-UX, eine klare Objekt-Detailseite und
          einen Beispiel-Anfrageflow.
        </p>
        <ul class="mt-6 space-y-3 text-lg text-muted">
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Objektliste mobil (schnell & klar)</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Filter-UX (portal-ähnlich)</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Objekt-Detailseite mit klarer Anfrageführung</span>
          </li>
          <li class="flex items-start gap-3">
            <Icon name="tabler:check" class="mt-1 h-5 w-5 text-primary" />
            <span>Beispiel für Step-Form</span>
          </li>
        </ul>
        <div class="mt-8">
          <Button variant="secondary" href="#kontakt">Demo anfragen</Button>
        </div>
      </div>
      <div class="relative rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 shadow-lg">
        <div class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-gray-500">Demo</div>
        <div class="mt-4 space-y-3">
          <div class="h-3 w-1/2 rounded-full bg-gray-200"></div>
          <div class="h-32 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900"></div>
          <div class="grid gap-3 md:grid-cols-2">
            <div class="h-20 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900"></div>
            <div class="h-20 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900"></div>
          </div>
        </div>
      </div>
    </div>
  </WidgetWrapper>

  <!-- 12) FAQ -->
  <WidgetWrapper id="faq" containerClass="max-w-6xl">
    <Headline title="FAQ" />
    <div class="mx-auto max-w-3xl divide-y divide-slate-200 dark:divide-slate-700 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-sm">
      {[
        {
          q: 'Wie funktioniert der kostenlose Prototyp genau?',
          a: 'Sie senden mir Ihre Website und 1–2 Beispielobjekte. Ich erstelle daraus eine klickbare Vorschau: Startseite, Objekt-Übersicht und Objekt-Detailseite.',
        },
        {
          q: 'Was brauche ich für den Prototyp?',
          a: 'Website-URL, Logo (falls vorhanden) und 1–2 Objektlinks oder PDFs. Mehr nicht.',
        },
        {
          q: 'Ist der Prototyp wirklich kostenlos?',
          a: 'Ja. Er dient dazu, dass Sie den Unterschied sofort sehen. Ohne Verpflichtung.',
        },
        {
          q: 'Was passiert nach den 7 Tagen?',
          a: 'Sie bekommen die Vorschau. Wenn Sie möchten, planen wir daraus die vollständige Umsetzung und aktivieren optional Module.',
        },
        {
          q: 'Kann ich später Automationen hinzufügen?',
          a: 'Ja. Die Website wird so aufgebaut, dass Module später ergänzbar sind, ohne Neuaufbau.',
        },
        {
          q: 'Ist das nur für Agrar/Forst?',
          a: 'Der Fokus ist Agrar/Forst/Landwirtschaft, weil dort Filter, Struktur und Dokumente besonders entscheidend sind. Andere Objektarten sind möglich, aber die Spezialisierung ist Ihr Vorteil.',
        },
      ].map((item) => (
        <details class="group px-6 py-4">
          <summary class="flex cursor-pointer items-center justify-between text-lg font-semibold text-heading">
            <span>{item.q}</span>
            <Icon name="tabler:plus" class="h-5 w-5 text-primary transition-transform group-open:rotate-45" />
          </summary>
          <p class="mt-3 text-muted leading-relaxed">{item.a}</p>
        </details>
      ))}
    </div>
  </WidgetWrapper>

  <!-- 13) CTA BANNER -->
  <section class="relative bg-slate-900 text-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-12 md:py-16 text-center">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tight">
        Wenn Sie mehr Abschlüsse wollen, starten Sie nicht mit „Design“. Starten Sie mit Ihrem Funnel.
      </h2>
      <div class="mt-6 flex flex-col items-center gap-4">
        <Button variant="primary" href="#kontakt">Kostenlosen 7-Tage-Prototyp anfragen</Button>
        <p class="text-sm text-slate-300">Kurzformular – Ergebnis in 7 Tagen.</p>
      </div>
    </div>
  </section>

  <!-- 14) CONTACT -->
  <WidgetWrapper id="kontakt" containerClass="max-w-6xl">
    <Headline
      title="Kostenlosen 7-Tage-Prototyp anfragen"
      subtitle="Senden Sie mir Ihre Website und ein Beispielobjekt. Ich erstelle daraus eine klickbare Vorschau mit drei Seiten."
    />
    <div class="max-w-4xl mx-auto rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 shadow-lg p-6 md:p-8">
      <form action="mailto:kontakt@topmaklerwebsites.de" method="post" enctype="text/plain">
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <label class="block text-sm font-medium" for="vorname">Vorname</label>
            <input
              id="vorname"
              name="vorname"
              type="text"
              required
              class="mt-2 w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 text-md text-slate-700 dark:text-slate-300"
            />
          </div>
          <div>
            <label class="block text-sm font-medium" for="nachname">Nachname</label>
            <input
              id="nachname"
              name="nachname"
              type="text"
              required
              class="mt-2 w-full rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 px-4 py-3 text-md text-slate-700 dark:text-slate-300"
            />
          </div>
          <div>
            <label class="block text-sm font-medium" for="firma">Firma</label>
            <input
