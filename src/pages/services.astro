---
import CallToAction from '~/components/widgets/CallToAction.astro';
import Content from '~/components/widgets/Content.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Hero from '~/components/widgets/Hero.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Servicios — Pronto',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="Servicios"
    title="Herramientas digitales para negocios reales"
    subtitle="Plataforma de catálogo digital y gestión de pedidos diseñada para pequeños negocios que quieren vender más por WhatsApp."
    actions={[{ variant: 'primary', target: '_blank', text: 'Explorar plataformas', href: '/' }]}
    image={{
      src: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1740&q=80',
      alt: 'Hero Image',
    }}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Todo lo que necesitas para digitalizar tu negocio"
    subtitle="Plataforma completa para crear catálogos digitales, gestionar pedidos por WhatsApp y hacer seguimiento en tiempo real."
    columns={3}
    items={[
      {
        title: 'Catálogo con IA',
        description:
          'Sube una foto de tu menú impreso y Pronto genera automáticamente el catálogo completo con precios y descripciones. En 5 minutos tienes tu menú digital listo.',
        icon: 'tabler:school',
      },
      {
        title: 'Gestión de productos',
        description:
          'Agrega, edita, elimina o desactiva productos desde la app. Todos los cambios se reflejan en tiempo real en el catálogo de tus clientes.',
        icon: 'tabler:home-star',
      },
      {
        title: 'Pedidos por WhatsApp',
        description: `Cada pedido llega directo a la app con confirmación SMS. Todo organizado sin perder detalle y listo para entregar.`,
        icon: 'tabler:photo',
      },
      {
        title: 'Tracking en tiempo real',
        description:
          'Tus clientes siguen su pedido paso a paso con URL de seguimiento y mapa en vivo del repartidor. Mejora la experiencia de compra.',
        icon: 'tabler:shopping-cart',
      },
      {
        title: 'App de repartidores',
        description:
          'Mapa integrado con la mejor ruta para tus entregas a domicilio. Tu repartidor ve la ruta y el cliente puede hacer seguimiento.',
        icon: 'tabler:article',
      },
      {
        title: 'Validación SMS',
        description:
          'Código de confirmación único para cada pedido. Adiós a los fraudes y pedidos falsos. Solo recibes pedidos reales.',
        icon: 'tabler:building-store',
      },
      {
        title: 'Estadísticas de ventas',
        description:
          'Conoce tus productos más vendidos, horarios pico y el crecimiento de tu negocio. Datos para tomar mejores decisiones.',
        icon: 'tabler:arrow-big-up-lines',
      },
      {
        title: 'Recoge en tienda o delivery',
        description:
          'Ofrece a tus clientes la flexibilidad de elegir cómo quieren recibir su pedido. Tú controlas las opciones desde la app.',
        icon: 'tabler:vaccine',
      },
      {
        title: 'Sin descargas para clientes',
        description:
          'Tus clientes piden desde el navegador. Solo compartes un link o código QR por WhatsApp. Sin apps ni registros.',
        icon: 'tabler:tie',
      },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isReversed
    items={[
      {
        title: 'Fácil de usar',
        description:
          'Nuestra plataforma está diseñada para que cualquier persona la use desde el primer minuto, sin manuales ni capacitación.',
        icon: 'tabler:wand',
      },
      {
        title: 'Actualizaciones en tiempo real',
        description:
          'Cada cambio que haces en tu catálogo se refleja al instante en el menú de tus clientes. Precios nuevos, productos disponibles, todo al día.',
        icon: 'tabler:settings',
      },
      {
        title: 'Sin complicaciones técnicas',
        description:
          'No necesitas programar ni mantener un servidor. Nos encargamos de todo para que tú te enfoques en tu negocio.',
        icon: 'tabler:presentation',
      },
      {
        title: 'Compatible con todos los dispositivos',
        description:
          'Tu catálogo funciona perfectamente en cualquier celular o computadora. Sin descargas, sin apps, solo un link.',
        icon: 'tabler:carousel-horizontal',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1525909002-1b05e0c869d8?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=870&q=80',
      alt: 'Características de Pronto',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Características principales</h3>
    </Fragment>
  </Content>

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Aumenta tus ventas',
        description:
          'Más fácil para tus clientes pedir, más ventas para ti. El catálogo digital está disponible 24/7 para que cualquiera pueda hacer un pedido.',
        icon: 'tabler:clock',
      },
      {
        title: 'Apariencia profesional',
        description:
          'Un catálogo digital bien diseñado hace que tu negocio parezca más grande y organizado. Impresiona a tus clientes desde el primer pedido.',
        icon: 'tabler:school',
      },
      {
        title: 'Sin costos ocultos',
        description:
          'Solo pagas una tarifa mensual fija. Sin comisiones por pedido, sin cargos extra. Sabes exactamente cuánto vas a pagar cada mes.',
        icon: 'tabler:coin',
      },
      {
        title: 'Comienza hoy mismo',
        description:
          'Crea tu catálogo en 5 minutos. Sube una foto de tu menú y deja que la IA haga el resto. No hay trials ni procesos largos.',
        icon: 'tabler:file-download',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1552664688-cf412ec27db2?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
      alt: 'Beneficios de Pronto',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">Beneficios</h3>
    </Fragment>
  </Content>

  <!-- Testimonials Widget *********** -->

  <Testimonials
    title="Lo que dicen nuestros clientes"
    testimonials={[
      {
        testimonial: `Pronto ha transformado completamente cómo recibimos pedidos. Nuestra clientela ya no tiene que llamarnos para hacer pedidos, simplemente abren el link y eligen lo que quieren. Ha aumentado nuestras ventas un 40%`,
        name: 'Carlos Ramírez',
        job: 'Propietario de Pizzería La Delicia',
        image: {
          src: 'https://images.unsplash.com/photo-1618835962148-cf177563c6c0?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=930&q=80',
          alt: 'Carlos Ramírez Image',
        },
      },
      {
        testimonial: `La plataforma es súper fácil de usar y mis clientes adoran que pueden ver el menú completo y hacer pedidos desde su celular. El tracking en tiempo real ha reducido significativamente las llamadas preguntando por sus pedidos.`,
        name: 'Ana Méndez',
        job: 'Propietaria de Heladería Dulce Sol',
        image: {
          src: 'https://images.unsplash.com/photo-1561406636-b80293969660?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=774&q=80',
          alt: 'Ana Méndez Image',
        },
      },
      {
        testimonial: `He recomendado Pronto a todos mis conocidos que tienen negocios de comida. La IA que crea el catálogo a partir de una foto de la carta es genial. Ahorré horas de trabajo escribiendo descripciones.`,
        name: 'Luis Fernández',
        job: 'Propietario de Restaurante Sabores',
        image: {
          src: 'https://images.unsplash.com/photo-1545167622-3a6ac756afa4?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=824&q=80',
          alt: 'Luis Fernández Image',
        },
      },
    ]}
    callToAction={{
      target: '_blank',
      text: 'Ver más testimonios...',
      href: '#',
      icon: 'tabler:chevron-right',
    }}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Explorar servicios',
        href: '/',
      },
    ]}
    title="Empieza a vender más hoy mismo"
    subtitle="Convierte tu negocio en un catálogo digital. Recibe pedidos por WhatsApp sin complicaciones."
  />
</Layout>
