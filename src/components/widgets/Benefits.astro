---
// Composant Benefits - Affiche les 3 bénéfices clés de la phycocyanine
export interface Props {
  id?: string;
}

const { id } = Astro.props;

const benefits = [
  {
    title: 'Antioxydant puissant',
    description: 'La phycocyanine est reconnue pour son pouvoir antioxydant exceptionnel, qui peut contribuer à protéger les cellules contre le stress oxydatif.',
    icon: 'shield',
  },
  {
    title: 'Soutien du système immunitaire',
    description: 'Traditionnellement utilisée pour renforcer les défenses naturelles de l\'organisme et soutenir le système immunitaire.',
    icon: 'heart',
  },
  {
    title: 'Énergie naturelle',
    description: 'Aide à réduire la fatigue et à maintenir une vitalité optimale au quotidien grâce à ses nutriments biodisponibles.',
    icon: 'bolt',
  },
];
---

<section class="not-prose bg-white py-16" {...id ? { id } : {}}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12">
      <h2 class="text-3xl md:text-4xl font-bold mb-4 text-gray-900" style="font-family: 'Playfair Display', serif;">
        Les bénéfices de la phycocyanine
      </h2>
      <p class="text-xl text-muted max-w-2xl mx-auto">
        Découvrez les principales propriétés de ce pigment bleu aux multiples vertus
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-8">
      {benefits.map((benefit) => (
        <div class="text-center">
          <!-- Icône -->
          <div class="mb-4 flex justify-center">
            <div class="w-16 h-16 bg-primary/10 rounded-full flex items-center justify-center">
              {benefit.icon === 'shield' && (
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                </svg>
              )}
              {benefit.icon === 'heart' && (
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                </svg>
              )}
              {benefit.icon === 'bolt' && (
                <svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              )}
            </div>
          </div>

          <!-- Titre -->
          <h3 class="text-xl font-bold mb-3 text-gray-900">
            {benefit.title}
          </h3>

          <!-- Description -->
          <p class="text-muted leading-relaxed">
            {benefit.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
