---
// Thin bar above the header. Everything is a prop so a site can change the
// message without touching the component; the defaults reproduce the demo.
export interface Props {
  badge?: string;
  text?: string;
  href?: string;
  showStars?: boolean;
}

const {
  badge = 'NEW',
  text = 'Astro v7 is now available! »',
  href = 'https://astro.build/blog/astro-7/',
  showStars = true,
} = Astro.props;
---

<div
  class="text-sm bg-slate-900 text-slate-300 dark:bg-transparent dark:border-b dark:border-slate-800 dark:text-slate-400 hidden lg:flex gap-1 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  {
    badge && (
      <span class="bg-white/20 dark:bg-slate-700 text-slate-100 dark:text-slate-300 font-semibold px-1 py-0.5 text-xs mr-0.5 rtl:mr-0 rtl:ml-0.5 inline-block">
        {badge}
      </span>
    )
  }
  {
    text &&
      (href ? (
        <a href={href} class="text-slate-300 hover:underline dark:text-slate-400 font-medium" set:html={text} />
      ) : (
        <span class="text-slate-300 dark:text-slate-400 font-medium" set:html={text} />
      ))
  }
  {
    showStars && (
      <a
        target="_blank"
        rel="noopener noreferrer"
        class="ltr:ml-auto rtl:mr-auto w-[5.6rem] h-[1.25rem] ml-auto bg-contain bg-right bg-no-repeat inline-block bg-[url(https://img.shields.io/github/stars/arthelokyo/astrowind.svg?style=social&label=Stars&maxAge=86400)]"
        title="If you like AstroWind, give us a star."
        href="https://github.com/arthelokyo/astrowind"
      >
        <span class="sr-only">GitHub stars</span>
      </a>
    )
  }
</div>
