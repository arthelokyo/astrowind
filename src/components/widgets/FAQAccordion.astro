---
import { Icon } from 'astro-icon/components';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Widget } from '~/types';

interface FAQItem {
  id: string;
  question: string;
  answer: string;
}

interface FAQSection {
  id: string;
  title: string;
  items: FAQItem[];
}

interface Props extends Widget {
  sections: FAQSection[];
}

const { sections = [], id, isDark = false, classes = {}, bg = await Astro.slots.render('bg') } = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-5xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <nav aria-label="Categorías de preguntas frecuentes" class="mb-12 flex flex-wrap justify-center gap-3">
    {
      sections.map((section) => (
        <a
          href={`#${section.id}`}
          class="rounded-full border border-primary/30 px-5 py-2 font-semibold text-primary transition-colors hover:bg-primary hover:text-white dark:border-primary/50"
        >
          {section.title}
        </a>
      ))
    }
  </nav>

  <div class="mx-auto max-w-4xl space-y-20">
    {
      sections.map((section) => (
        <section id={section.id} aria-labelledby={`faq-section-${section.id}`} class="scroll-mt-32">
          <h2
            id={`faq-section-${section.id}`}
            class="mb-6 border-b border-primary/20 pb-3 text-2xl font-bold tracking-tight text-primary dark:text-accent sm:text-3xl"
          >
            {section.title}
          </h2>

          <div class="grid gap-3">
            {section.items.map((item, index) => (
              <details
                id={item.id}
                name={`faq-${section.id}`}
                open={index === 0}
                class="group scroll-mt-32 rounded-lg border border-transparent transition-colors duration-200 open:border-primary/20 open:bg-primary/[0.04] dark:open:bg-primary/[0.08]"
              >
                <summary class="grid cursor-pointer list-none grid-cols-[1.5rem_minmax(0,1fr)] items-start gap-x-3 rounded-lg px-4 py-4 text-left text-lg font-semibold text-slate-800 marker:content-none transition-colors duration-200 hover:text-slate-950 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary group-open:text-primary dark:text-slate-100 dark:hover:text-white dark:group-open:text-primary">
                  <Icon
                    name="tabler:chevron-right"
                    aria-hidden="true"
                    class="mt-1 h-6 w-6 text-primary transition-transform duration-200 group-open:rotate-90"
                  />
                  <span>{item.question}</span>
                </summary>
                <div class="grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-3 px-4 pb-5">
                  <span aria-hidden="true" />
                  <div
                    class="faq-answer prose prose-base max-w-none text-muted dark:prose-invert dark:text-slate-300"
                    set:html={item.answer}
                  />
                </div>
              </details>
            ))}
          </div>
        </section>
      ))
    }
  </div>
</WidgetWrapper>

<style>
  .faq-answer :global(ul) {
    list-style-type: disc;
    margin-block: 1em;
    padding-inline-start: 1.625em;
  }

  .faq-answer :global(ol) {
    list-style-type: decimal;
    margin-block: 1em;
    padding-inline-start: 1.625em;
  }

  .faq-answer :global(li) {
    padding-inline-start: 0.25em;
  }

  .faq-answer :global(ul > li::marker) {
    color: var(--aw-color-primary);
  }

  details[open] .faq-answer {
    animation: faq-answer-reveal 220ms ease-out both;
  }

  @keyframes faq-answer-reveal {
    from {
      opacity: 0;
      transform: translateY(-0.25rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    details[open] .faq-answer {
      animation: none;
    }
  }
</style>
