---
// Composant ProductHighlight - Affiche 1 produit recommandé
import Image from '~/components/common/Image.astro';

export interface Props {
  id?: string;
}

const { id } = Astro.props;
---

<section class="not-prose bg-white py-16" {...id ? { id } : {}}>
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="border border-gray-200 rounded-lg p-8 md:p-10">
      <h2 class="text-2xl md:text-3xl font-bold mb-8 text-center" style="font-family: 'Playfair Display', serif;">
        Notre sélection
      </h2>

      <div class="md:flex md:gap-8 items-start">
        <!-- Image du produit -->
        <div class="md:w-1/3 mb-6 md:mb-0">
          <div class="bg-gray-100 rounded-lg aspect-square flex items-center justify-center">
            <p class="text-gray-400 text-sm">Image produit</p>
          </div>
        </div>

        <!-- Description du produit -->
        <div class="md:w-2/3">
          <h3 class="text-xl font-bold mb-3 text-gray-900">
            Phycocyanine Premium - Marque X
          </h3>

          <p class="text-muted mb-4 leading-relaxed">
            Phycocyanine liquide issue de spiruline cultivée en bassins contrôlés. Concentration de 25 mg/ml,
            extraction à froid pour préserver les propriétés. Origine France, certifiée bio.
          </p>

          <ul class="text-sm text-muted mb-6 space-y-2">
            <li>• Format : Flacon de 250 ml</li>
            <li>• Posologie : 1 bouchon (10 ml) par jour</li>
            <li>• Conservation : Au réfrigérateur après ouverture</li>
          </ul>

          <a
            href="/produits"
            class="inline-flex items-center px-6 py-3 bg-primary text-white font-semibold rounded-lg hover:bg-[#4A6358] transition-colors"
          >
            Découvrir ce produit →
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
