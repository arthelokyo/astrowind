---
import Button from '~/components/ui/Button.astro';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  id,
} = Astro.props;
---

<section class="relative md:-mt-[76px] not-prose bg-white" {...id ? { id } : {}}>
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
    <div class="pt-0 md:pt-[76px] pointer-events-none"></div>
    <div class="py-20 md:py-32">
      <div class="text-center max-w-4xl mx-auto">
        {
          title && (
            <h1
              class="text-5xl md:text-6xl font-bold leading-tight mb-6 text-gray-900"
              style="font-family: 'Playfair Display', serif;"
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl mx-auto">
          {
            subtitle && (
              <p
                class="text-xl md:text-2xl text-muted mb-10 leading-relaxed"
                set:html={subtitle}
              />
            )
          }
          {
            actions && (
              <div class="max-w-lg m-auto flex flex-col sm:flex-row sm:justify-center gap-4">
                {Array.isArray(actions) ? (
                  actions.map((action) => (
                    <div class="flex w-full sm:w-auto">
                      <Button {...(action || {})} class="w-full sm:mb-0" />
                    </div>
                  ))
                ) : (
                  <Fragment set:html={actions} />
                )}
              </div>
            )
          }
        </div>
        {content && <div class="mt-8"><Fragment set:html={content} /></div>}
      </div>
    </div>
  </div>
</section>
