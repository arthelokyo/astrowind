---
import { UI } from 'astrowind:config';
---

<script is:inline define:vars={{ defaultTheme: UI.theme || 'system' }}>
  const STORAGE_KEY = 'aw-color-scheme';
  const LEGACY_KEY = 'theme'; // read-only fallback
  const systemMedia = window.matchMedia('(prefers-color-scheme: dark)');

  const getStoredTheme = () => localStorage.getItem(STORAGE_KEY) || localStorage.getItem(LEGACY_KEY);
  const applyTheme = (theme) => {
    const isDark = theme === 'dark';
    document.documentElement.classList.toggle('dark', isDark);
    document.documentElement.setAttribute('data-aw-theme', theme);
    document.querySelectorAll('[data-aw-toggle-color-scheme]').forEach((btn) =>
      btn.setAttribute('aria-pressed', String(isDark))
    );
  };

  const preferredFromSystem = () => (systemMedia.matches ? 'dark' : 'light');

  let stored = getStoredTheme();
  let theme =
    stored === 'light' || stored === 'dark'
      ? stored
      : defaultTheme && defaultTheme.endsWith(':only')
        ? defaultTheme.replace(':only', '')
        : preferredFromSystem();

  // Apply before paint
  applyTheme(theme);

  // Follow system changes only when user has not chosen
  if (!stored) {
    systemMedia.addEventListener('change', (e) => applyTheme(e.matches ? 'dark' : 'light'));
  }

  const handleToggle = () => {
    const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
    theme = next;
    applyTheme(next);
    localStorage.setItem(STORAGE_KEY, next);
  };

  window.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-aw-toggle-color-scheme]').forEach((btn) =>
      btn.addEventListener('click', handleToggle, false)
    );
  });
</script>
