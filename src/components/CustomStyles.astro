---
// Fonts chargées via Google Fonts dans le Layout
---

<style is:inline>
  :root {
    /* Fonts - Playfair Display pour les titres, Inter pour le corps */
    --aw-font-sans: 'Inter', sans-serif;
    --aw-font-serif: 'Playfair Display', serif;
    --aw-font-heading: 'Playfair Display', serif;

    /* Couleurs - Thème vert sauge */
    --aw-color-primary: rgb(91 122 107);       /* #5B7A6B - Vert sauge */
    --aw-color-secondary: rgb(74 99 88);       /* #4A6358 - Vert sauge foncé (hover) */
    --aw-color-accent: rgb(91 122 107);        /* #5B7A6B - Même que primary */

    /* Texte */
    --aw-color-text-heading: rgb(26 26 26);    /* #1A1A1A - Texte principal */
    --aw-color-text-default: rgb(26 26 26);    /* #1A1A1A - Texte principal */
    --aw-color-text-muted: rgb(107 114 128);   /* #6B7280 - Texte secondaire */

    /* Backgrounds */
    --aw-color-bg-page: rgb(255 255 255);      /* #FFFFFF - Fond principal */
    --aw-color-bg-page-dark: rgb(250 250 248); /* #FAFAF8 - Fond sections alternées */

    ::selection {
      background-color: rgb(91 122 107 / 20%);
      color: rgb(26 26 26);
    }
  }

  /* Typographie selon directives */
  h1, .h1 {
    font-family: 'Playfair Display', serif;
    font-size: 48px;
    font-weight: 600;
  }

  h2, .h2 {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 600;
  }

  h3, .h3 {
    font-family: 'Playfair Display', serif;
    font-size: 24px;
    font-weight: 500;
  }

  body {
    font-family: 'Inter', sans-serif;
    font-size: 17px;
    line-height: 1.7;
  }
</style>
